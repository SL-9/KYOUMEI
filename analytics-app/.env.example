# =========================================
# Kyoumei Analytics App - 環境変数サンプル
# =========================================
# このファイルを .env.local にコピーして値を設定してください
# .env.local は絶対にGitにコミットしないでください

# --- Supabase ---
# Supabaseプロジェクトの Settings > API で確認できます
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Service Role Key (サーバーサイドのみ使用 - 絶対にブラウザに公開しない)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# --- 管理者設定 ---
# このメールアドレスのアカウントのみダッシュボードにアクセスできます
ADMIN_EMAIL=your-admin-email@example.com

# --- アクセス解析の有効/無効 ---
# falseにするとイベントが送信されません
NEXT_PUBLIC_ANALYTICS_ENABLED=true

# --- CORSの許可オリジン ---
# アクセス解析を計測するサイトのURL (既存のKyoumeiサイト)
ANALYTICS_ALLOWED_ORIGIN=https://kyoumei.app,https://www.kyoumei.app

# --- このアプリ自身のURL ---
# tracking.jsから呼び出すAPIのベースURL (Vercelデプロイ後に取得)
# 例: https://kyoumei-analytics.vercel.app
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- ローカルUI確認専用 ---
# npm run dev:demo が起動時に設定します。本番のVercelには設定しないでください。
# ANALYTICS_DEMO_MODE=true
